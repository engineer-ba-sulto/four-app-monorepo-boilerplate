# Expo loads env by mode (NODE_ENV):
#   cp .env.development.example .env.development   # expo start
#   cp .env.production.example .env.production       # eas build / expo export
#
# URL values differ per environment — see those files for EXPO_PUBLIC_APP_URL,
# EXPO_PUBLIC_API_URL, EXPO_PUBLIC_SITE_URL, and EXPO_PUBLIC_APP_NAME.
